---
import Metaicon from "@/components/foundation/Metaicon.astro";
import "../styles/proyectiva.css";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} | Proyectiva` : "Proyectiva";
const siteDescription =
  "Proyectiva es una empresa dedicada a ofrecer soluciones de seguros para proteger su salud, vida, hogar y autos en Colombia.";
const siteKeywords =
  "proyectiva, seguros, salud, vida, hogar, autos, colombia";
const canonicalUrl = "https://www.proyectivaseguros.com";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <Metaicon />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteDescription} />
    <meta name="keywords" content={siteKeywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta
      name="google-site-verification"
      content="GKdjbJ8tlpDX2EdBwIYYNaEx40jiC64qkFutJsjkzFM"
    />
    <link
      rel="icon"
      href="https://www.proyectivaseguros.com/assets/img/icon_proyectiva.ico"
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      src="https://kit.fontawesome.com/30b50e5828.js"
      crossorigin="anonymous"></script>
    <title>{pageTitle}</title>

    <link
      href="https://www.segurosbolivar.com/comunicaciones/000-assets/webfont/bolivar.css"
      rel="stylesheet"
    />
    <link
      rel="preload"
      href="assets/fonts/bolivar.woff"
      as="font"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="https://www.segurosbolivar.com/assets/fonts/bolivar/Bolivar-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FinancialService",
        "name": "Proyectiva",
        "url": "https://www.proyectiva.com",
        "logo": "https://www.proyectiva.com/logo.png",
        "description": "Proyectiva es una empresa dedicada a ofrecer soluciones de seguros para proteger su salud, vida, hogar y autos en Colombia.",
        "areaServed": "CO",
        "sameAs": [
          "https://www.facebook.com/SegurosBolivar",
          "https://www.linkedin.com/company/seguros-bolivar",
          "https://www.instagram.com/segurosbolivar"
        ]
      }
    </script>
  </head>
  <body>
    <slot />

    <script>
      // Scroll suave a la sección indicada en [data-scroll-to] sin escribir el
      // hash en la URL (evita el "#seccion" que deja un <a href>).
      const initScrollTo = () => {
        if (document.body.dataset.scrollToBound === "true") {
          return;
        }

        document.body.dataset.scrollToBound = "true";

        document.addEventListener("click", (event) => {
          const objetivo = event.target instanceof Element ? event.target : null;
          const disparador = objetivo?.closest<HTMLElement>("[data-scroll-to]");

          if (!disparador) {
            return;
          }

          const selector = disparador.dataset.scrollTo;

          if (!selector) {
            return;
          }

          const destino = document.querySelector(selector);

          if (!destino) {
            return;
          }

          event.preventDefault();
          destino.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initScrollTo, { once: true });
      } else {
        initScrollTo();
      }
    </script>
  </body>
</html>
