---
interface HeaderLink {
  text: string;
  url: string;
}

interface HeaderCta {
  text: string;
  url: string;
}

interface Props {
  ctaScrollTo?: string;
  header?: {
    logo?: string;
    desktopLinks?: HeaderLink[];
    mobileLinks?: HeaderLink[];
    cta?: HeaderCta;
  };
}

const { header, ctaScrollTo } = Astro.props;

const defaultCtaUrl = ctaScrollTo ?? header?.cta?.url ?? "#contacto";

const headerConfig = {
  logo: header?.logo ?? "https://hely.com.co/php/assets/img/logo/logo.png",
  desktopLinks: header?.desktopLinks ?? [
    { text: "Servicios", url: "#servicios" },
    { text: "Sobre Hely", url: "#nosotros" },
    { text: "Equipo", url: "#equipo" },
    { text: "Contacto", url: "#contacto" },
  ],
  mobileLinks: header?.mobileLinks ?? [
    { text: "Servicios", url: "#servicios" },
    { text: "Sobre Hely", url: "#nosotros" },
    { text: "Equipo", url: "#equipo" },
    { text: "Contacto", url: "#contacto" },
  ],
  cta: {
    text: header?.cta?.text ?? "Escribenos",
    url: defaultCtaUrl,
  },
};

const getScrollToSelector = (url: string) => (url.startsWith("#") ? url : undefined);
---

<header class="sticky top-0 z-50 w-full border-b border-white/30 bg-[#f5f4fc]/95 backdrop-blur-md">
  <input type="checkbox" id="menu-toggle" class="peer hidden" />

  <div class="shell flex items-center justify-between py-5">
    <a href="#top" class="flex items-center" aria-label="Hely" data-scroll-to="#top">
      <img
        src={headerConfig.logo}
        alt="Hely"
        class="h-9 w-auto object-contain md:h-10"
        onerror="this.src='https://placehold.co/120x40/f5f4fc/160f32?text=hely.'"
      />
    </a>

    <nav class="hidden flex-1 items-center justify-center lg:flex">
      <div class="flex items-center gap-12 xl:gap-14">
        {headerConfig.desktopLinks.map((link) => (
          <a
            href={link.url}
            data-scroll-to={getScrollToSelector(link.url)}
            class="text-[0.92rem] font-semibold uppercase tracking-[0.12em] text-[#5b5575] transition-colors duration-200 hover:text-[#22153f]"
          >
            {link.text}
          </a>
        ))}
      </div>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={headerConfig.cta.url}
        data-scroll-to={getScrollToSelector(headerConfig.cta.url)}
        class="hidden items-center gap-2 rounded-full bg-[#20103e] px-7 py-3 text-base font-semibold text-white transition-colors duration-200 hover:bg-[#160a31] sm:inline-flex interactive-focus-ring"
      >
        {headerConfig.cta.text}
        <span aria-hidden="true" class="text-lg leading-none">&nearr;</span>
      </a>

      <label
        for="menu-toggle"
        class="rounded-lg p-2 text-neutral-20 transition-colors hover:text-[#20103e] lg:hidden"
        aria-label="Abrir menu"
      >
        <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.1" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>
    </div>
  </div>

  <div class="peer-not-checked:hidden peer-checked:flex absolute left-0 top-full w-full flex-col border-t border-[#e6e2f0] bg-[#f8f7fd] shadow-[0_10px_30px_rgba(28,14,60,0.08)] lg:hidden">
    <div class="shell py-4">
      <nav class="flex flex-col">
        {headerConfig.mobileLinks.map((link) => (
          <a
            href={link.url}
            data-scroll-to={getScrollToSelector(link.url)}
            class="border-b border-[#ebe8f3] py-3.5 text-sm font-semibold uppercase tracking-[0.12em] text-[#433b58] transition-colors hover:text-[#22153f]"
          >
            {link.text}
          </a>
        ))}

        <a
          href={headerConfig.cta.url}
          data-scroll-to={getScrollToSelector(headerConfig.cta.url)}
          class="mt-5 inline-flex items-center justify-center gap-2 rounded-full bg-[#20103e] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#160a31] sm:hidden"
        >
          {headerConfig.cta.text}
          <span aria-hidden="true">&nearr;</span>
        </a>
      </nav>
    </div>
  </div>
</header>