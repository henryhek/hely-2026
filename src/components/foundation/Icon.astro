  'pressed-secundaria': 'text-pressed-secundaria',
  'en-secundaria': 'text-en-secundaria',
} as const;

const sizeClasses = {
  xs: 'text-xs',
  sm: 'text-sm',
  base: 'text-base',
  lg: 'text-lg',
  xl: 'text-xl',
  '2xl': 'text-2xl',
  '3xl': 'text-3xl',
  '4xl': 'text-4xl',
} as const;

interface Props {
  name: string;
  color?: keyof typeof colorClasses;
  size?: keyof typeof sizeClasses;
  variant?: 'regular' | 'light' | 'solid' | 'brands';
  className?: string;
}

const {
  name,
  color,
  size,
  variant = 'regular',
  className = '',
} = Astro.props;

const variantClass = variant === 'light'
  ? 'fa-light'
  : variant === 'solid'
    ? 'fa-solid'
    : variant === 'brands'
      ? 'fa-brands'
      : 'fa-regular';
const colorClass = color ? colorClasses[color] : undefined;
const sizeClass = size ? sizeClasses[size] : undefined;
---

<i
  class:list={[variantClass, `fa-${name}`, colorClass, sizeClass, className]}
  aria-hidden="true"
></i>
