---
import Card from "@/components/molecules/Card.astro";
import CarouselControls from "@/components/molecules/CarouselControls.astro";
import { resolveSectionData } from "@/data/resolveSectionData";

interface AssistanceRecord {
  imageSrc: string;
  imageAlt: string;
  titulo: string;
  copy: string;
}

interface SectionContent {
  titulo: string;
  asistencias: AssistanceRecord[];
}

interface Props {
  class?: string;
  id?: string;
  data?: string;
  fondo?: string;
  idBase?: string;
  titulo?: string;
  asistencias?: AssistanceRecord[];
}

const defaultAsistencias: AssistanceRecord[] = [
  {
    imageSrc: "https://image.experienciasbolivar.segurosbolivar.com/lib/fe3511747364047b751475/m/1/bb16238a-f5ad-42dc-85f6-ad2180b56f94.jpg",
    imageAlt: "Conductor elegido para traslado seguro.",
    titulo: "Conductor elegido",
    copy: "Solicite un conductor para que lo lleve a casa en su propio vehiculo cuando no se sienta en condiciones de manejar.",
  },
  {
    imageSrc: "https://image.experienciasbolivar.segurosbolivar.com/lib/fe3511747364047b751475/m/1/6d6fa99a-a5ec-4f9f-aae1-24b88490c6d4.jpg",
    imageAlt: "Servicio de carro taller.",
    titulo: "Carro taller",
    copy: "Reciba ayuda con carro taller ante bateria descargada, cambio de llanta o combustible. Disponible en ciudades principales.",
  },
  {
    imageSrc: "https://image.experienciasbolivar.segurosbolivar.com/lib/fe3511747364047b751475/m/1/97b933f4-ef61-4e3b-9c24-536c545470c5.jpg",
    imageAlt: "Servicio de grua para traslado del vehiculo.",
    titulo: "Grua",
    copy: "Traslade su carro por accidente, robo o fallas mecanicas hacia su residencia, taller o ciudad principal.",
  },
  {
    imageSrc: "https://image.experienciasbolivar.segurosbolivar.com/lib/fe3511747364047b751475/m/1/2ac0246c-83ff-49f1-96f8-2848920f7277.jpg",
    imageAlt: "Conductor familiar para traslados.",
    titulo: "Conductor familiar",
    copy: "Solicite un conductor que lo traslade a usted, su familia o su vehiculo maximo durante 3 horas.",
  },
  {
    imageSrc: "https://image.experienciasbolivar.segurosbolivar.com/lib/fe3511747364047b751475/m/1/22eb0363-200d-4a89-8413-37fe069978ea.jpg",
    imageAlt: "Servicio de valet parking para invitados.",
    titulo: "Valet parking",
    copy: "Delegue el recibir, estacionar y cuidar los vehiculos de sus invitados en el lugar que usted defina.",
  },
];

const {
  class: className = "",
  id,
  data: dataPath,
  fondo = "bg-white",
  idBase = "asistenciasSection",
  titulo,
  asistencias,
} = Astro.props;

const defaultContent: SectionContent = {
  titulo: "Asistencias incluidas",
  asistencias: defaultAsistencias,
};

const sectionContent = resolveSectionData<SectionContent>(dataPath, defaultContent);
const finalTitulo = titulo ?? sectionContent.titulo;
const finalAsistencias = asistencias ?? sectionContent.asistencias;
---

<section id={id} class:list={["w-full py-10 md:py-10 xl:py-16", fondo, className]}>
  <div class="shell lg:px-10! xl:px-[72px]!">
    <div class="flex flex-col gap-10 md:gap-12">
      <div class="flex items-end justify-between gap-4">
        <h2 class="m-0 text-2xl leading-8 font-bold text-neutral-10 md:text-[2rem] md:leading-10">
          {finalTitulo}
        </h2>

        <CarouselControls
          target={idBase}
          prevLabel="Ver asistencia anterior"
          nextLabel="Ver siguiente asistencia"
        />
      </div>

      <div
        class="-mx-6 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-px-6 px-6 md:-mx-4 md:scroll-px-4 md:px-4 lg:-mx-10 lg:scroll-px-10 lg:px-10 xl:mx-0 xl:scroll-px-0 xl:px-0 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        data-carousel-scroll={idBase}
      >
        {finalAsistencias.map((asistencia) => (
          <div
            class="min-w-0 shrink-0 basis-full snap-start md:max-w-[340px] md:basis-[340px] xl:max-w-none xl:basis-[calc((100%-3rem)/3)]"
          >
            <Card
              tipo="imagen"
              estilo="outlined"
              imageSrc={asistencia.imageSrc}
              imageAlt={asistencia.imageAlt}
              titulo={asistencia.titulo}
              copy={asistencia.copy}
              className=""
              copyClassName="text-neutral-10"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
