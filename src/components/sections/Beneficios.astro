---
// Servicios.astro
import Card from "@/components/molecules/Card.astro";

interface ServiceRecord {
  imageSrc?: string;
  imageAlt?: string;
  icono?: string;
  titulo: string;
  copy: string;
  bgCircleColor?: string;
}

interface Props {
  class?: string;
  id?: string;
  fondo?: string;
  titulo?: string;
  servicios?: ServiceRecord[];
}

const defaultServicios: ServiceRecord[] = [
  {
    imageSrc: "https://hely.com.co/php/assets/img/icon/services_icon04.png",
    imageAlt: "Ilustración 3D Diseño Web",
    titulo: "Diseño Web",
    copy: "Creación y Asesoría de sitios web adaptables.",
    bgCircleColor: "bg-[#fff7e6]",
  },
  {
    imageSrc: "https://hely.com.co/php/assets/img/icon/services_icon04.png",
    imageAlt: "Ilustración 3D Estrategia de comunicación",
    titulo: "Estrategia de comunicación",
    copy: "Planes de comunicación interna, Campañas de comunicación interna y Comunicación en crisis.",
    bgCircleColor: "bg-primario-95",
  },
  {
    imageSrc: "https://hely.com.co/php/assets/img/icon/services_icon04.png",
    imageAlt: "Ilustración 3D Gestión del cambio",
    titulo: "Gestión del cambio",
    copy: "Propuesta de valor al empleado y marca empleadora.",
    bgCircleColor: "bg-[#f0f2f5]",
  },
];

const {
  class: className = "",
  id = "servicios",
  fondo = "bg-white",
  titulo = "Nuestros Servicios",
  servicios = defaultServicios,
} = Astro.props;

// Nos aseguramos de tener un array válido
const listaServicios = servicios && servicios.length > 0 ? servicios : defaultServicios;

const words = titulo.trim().split(" ");
const lastWord = words.length > 1 ? words.pop() : "";
const mainTitle = words.join(" ");
---

<section id={id} class:list={["w-full py-16 md:py-24 relative overflow-hidden", fondo, className]}>
  <div class="shell">
    <div class="flex flex-col gap-12">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="m-0 text-3xl md:text-4xl lg:text-5xl font-extrabold text-neutral-10 tracking-tight leading-tight">
          {mainTitle} {lastWord && <span class="text-primario-50">{lastWord}</span>}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
        {listaServicios.map((servicio) => (
          <Card
            tipo={servicio.imageSrc ? "imagen" : "icono"}
            estilo="elevada"
            imageSrc={servicio.imageSrc}
            imageAlt={servicio.imageAlt || servicio.titulo}
            icono={servicio.icono}
            titulo={servicio.titulo}
            copy={servicio.copy}
            iconContainerClassName={servicio.bgCircleColor || "bg-primario-95"}
            className="h-full"
          />
        ))}
      </div>
    </div>
  </div>
</section>