---
// Hero.astro
interface Props {
    id?: string;
}

const { id } = Astro.props;
---

<section id={id || "inicio"} class="relative isolate overflow-hidden bg-white pb-14 pt-8 md:pb-20 md:pt-10 lg:pb-24">
    <div class="absolute -left-24 -top-20 -z-10 h-105 w-105 rounded-full bg-[#eef1f7] md:h-155 md:w-155"></div>

    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
        <span class="float-orb orb-a"></span>
        <span class="float-orb orb-b"></span>
        <span class="float-orb orb-c"></span>
        <span class="float-orb orb-d"></span>
    </div>

    <div class="shell relative z-10 grid items-center gap-10 md:grid-cols-12 md:gap-8 lg:gap-10">
        <div class="order-2 flex items-center justify-center md:col-span-6 md:order-1">
            <img
                src="https://hely.com.co/php/assets/img/banner/header-hely.png"
                alt="Ilustracion 3D Hely"
                class="h-auto w-full max-w-140 object-contain"
                onerror="this.src='https://placehold.co/560x540/f5f3f8/a843e6?text=Ilustracion+3D+Hely'"
            />
        </div>

        <div class="order-1 md:col-span-6 md:order-2">
            <div class="relative mb-6 inline-block max-w-160 rounded-full border border-[#ece9f4] bg-[#f7f5fb] px-5 py-2.5 text-sm font-semibold leading-tight text-neutral-20 sm:px-6 md:mb-8 md:text-[1.02rem]">
                Bienvenidos a <strong class="mx-1 text-primario-60">Hely</strong>, tu aliado experto en diseño web y comunicación interna.
            </div>

            <h1 class="max-w-170 text-[2.35rem] font-extrabold leading-[0.98] tracking-[-0.01em] text-neutral-10 sm:text-5xl md:text-[3.45rem] lg:text-[4.9rem]">
                Diseño web y consultoría de comunicación: tu impulso digital.
            </h1>

            <div class="mt-8 md:mt-10">
                <a
                    href="#contacto"
                    data-scroll-to="#contacto"
                    class="inline-flex min-w-49 items-center justify-center rounded-3xl bg-primario-60 px-8 py-4 text-lg font-semibold text-white shadow-[0_10px_30px_rgba(168,67,230,0.28)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-primario-50 hover:shadow-[0_14px_34px_rgba(168,67,230,0.34)] active:translate-y-0 interactive-focus-ring"
                >
                    Escribenos
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .float-orb {
        position: absolute;
        border-radius: 9999px;
        will-change: transform;
        animation-name: float-slow;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
    }

    .orb-a {
        top: 10%;
        left: 11%;
        width: 18px;
        height: 18px;
        background: radial-gradient(circle at 35% 30%, #f7c8f5 0%, #d86ed1 58%, #b637a8 100%);
        animation-duration: 17s;
    }

    .orb-b {
        top: 8%;
        left: 19%;
        width: 26px;
        height: 26px;
        background: radial-gradient(circle at 32% 30%, #e2ceff 0%, #9d77e6 58%, #6940ba 100%);
        animation-duration: 21s;
        animation-delay: -6s;
    }

    .orb-c {
        top: 20%;
        left: 8%;
        width: 58px;
        height: 58px;
        background: radial-gradient(circle at 35% 28%, #d2fff6 0%, #87d8cc 52%, #4ea5a6 100%);
        animation-duration: 24s;
        animation-delay: -12s;
        box-shadow: inset -10px -8px 18px rgba(32, 84, 88, 0.28);
    }

    .orb-d {
        bottom: 15%;
        left: 3%;
        width: 44px;
        height: 44px;
        background: radial-gradient(circle at 30% 28%, #ffffff 0%, #f0edf5 70%, #ddd5ea 100%);
        animation-duration: 26s;
        animation-delay: -9s;
    }

    @keyframes float-slow {
        0% {
            transform: translate3d(0, 0, 0) rotate(0deg);
        }
        25% {
            transform: translate3d(10px, -14px, 0) rotate(3deg);
        }
        50% {
            transform: translate3d(-8px, -20px, 0) rotate(-2deg);
        }
        75% {
            transform: translate3d(-14px, 8px, 0) rotate(2deg);
        }
        100% {
            transform: translate3d(0, 0, 0) rotate(0deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .float-orb {
            animation: none;
        }
    }
</style>