---
import Icon from "@/components/foundation/Icon.astro";

interface Props {
  titulo: string;
  metadata: string;
  url: string;
  className?: string;
}

const {
  titulo,
  metadata,
  url,
  className = "",
} = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Descargar ${titulo}`}
  class:list={[
    "group interactive-focus-ring flex min-h-14 w-full items-start gap-4 rounded-2xl p-1.5 text-left outline-none transition-colors duration-150 ease-out hover:bg-neutral-95 active:bg-neutral-90",
    className,
  ]}
>
  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-alerta-informacion-95 text-alerta-informacion-40">
    <Icon name="file" size="lg" variant="regular" />
  </div>

  <div class="flex min-w-0 flex-1 flex-col gap-2">
    <h3 class="m-0 text-xl leading-[1.4] font-semibold text-neutral-20">
      {titulo}
    </h3>
    <p class="m-0 text-sm leading-[1.4] text-primario-50">
      {metadata}
    </p>
  </div>

  <span
    aria-hidden="true"
    class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-boton-secundario-default text-boton-secundario-contenido transition-colors duration-150 ease-out group-hover:bg-white group-active:bg-neutral-95"
  >
    <Icon name="chevron-right" size="xs" variant="solid" />
  </span>
</a>
