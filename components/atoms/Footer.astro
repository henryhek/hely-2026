---
const currentYear = new Date().getFullYear();

interface Props {
  class?: string;
  additionalContent?: string;
}

const {
  class: additionalClasses = "",
  additionalContent = "",
} = Astro.props;

const footerContent = {
  empresa: "Proyectiva",
  descripcion: "Agencia de seguros 100% digital.<br>Cuidamos lo que más te importa, sin papeleo y sin letras chiquitas.",
  productos: [
    { text: "Seguro de arrendamiento", url: "/seguro-arrendamiento" },
    { text: "Seguro para carros", url: "/nuestros-productos/seguro-autos" },
    { text: "Seguro de salud", url: "/nuestros-productos/seguro-salud" },
    { text: "Seguro para pymes", url: "/nuestros-productos/seguro-pymes" },
    { text: "Seguro para la casa", url: "/nuestros-productos/seguro-casa" },
  ],
  interes: [
    { text: "Sobre nosotros", url: "#" },
    { text: "Centro de ayuda", url: "#" },
    { text: "Términos y condiciones", url: "#" },
    { text: "Política de tratamiento de datos", url: "#" },
    { text: "Radicación de PQRS", url: "#" },
  ],
  whatsapp: "https://api.whatsapp.com/send?phone=573223322322",
} as const;
---

<footer class={`w-full bg-white pb-8 mt-12 ${additionalClasses}`}>
  <div class="container mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid border-t pt-8 border-gray-200 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 md:gap-12 lg:gap-8 mb-10 md:mb-16">
      <div class="flex flex-col">
        <h3 class="text-3xl font-bold text-[#1A1A1A] mb-4">{footerContent.empresa}</h3>
        <p class="text-gray-600 leading-relaxed mb-6 text-sm md:text-base pr-4" set:html={footerContent.descripcion} />
        <div class="flex flex-col gap-5">
          <a href={footerContent.whatsapp} target="_blank" rel="noreferrer" class="flex items-center justify-center gap-2.5 border-2 border-[#009F4D] text-[#009F4D] font-bold px-6 py-2.5 rounded-full hover:bg-green-50 transition-colors w-fit text-sm md:text-base">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Escríbenos al WhatsApp
          </a>
          <div class="flex items-center gap-4 text-[#1A1A1A]">
            <a href="https://facebook.com/proyectivaseguros" target="_blank" rel="noreferrer" class="hover:text-gray-600 transition-colors">
              <svg class="w-[26px] h-[26px]" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.04c-5.5 0-9.96 4.46-9.96 9.96 0 4.96 3.62 9.07 8.39 9.83v-6.96h-2.53v-2.87h2.53v-2.18c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.86h2.78l-.45 2.87h-2.33v6.96c4.77-.76 8.39-4.87 8.39-9.83 0-5.5-4.46-9.96-9.96-9.96z"/></svg>
            </a>
            <a href="https://www.instagram.com/proyectivaseguros" target="_blank" rel="noreferrer" class="hover:text-gray-600 transition-colors">
              <svg class="w-[26px] h-[26px]" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5a4.25 4.25 0 0 0 4.25-4.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5zM12 7.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9zm0 1.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm5.25-3a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5z"/></svg>
            </a>
          </div>
        </div>
      </div>
      <div>
        <h4 class="text-[16px] font-bold text-[#1A1A1A] uppercase tracking-wide mb-4 md:mb-6">Nuestros Productos</h4>
        <ul class="space-y-4 md:space-y-5 text-gray-800 text-[15px]">
          {footerContent.productos.map((item) => (
            <li><a href={item.url} class="hover:text-[#E85D25]">{item.text}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="text-[16px] font-bold text-[#1A1A1A] uppercase tracking-wide mb-4 md:mb-6">Canales de Atención</h4>
        <ul class="space-y-4 text-gray-800 text-[15px]">
          <li><a href="mailto:cliente@proyectivaseguros.com" class="hover:text-[#E85D25]">cliente@proyectivaseguros.com</a></li>
          <li>Bogotá, Cra 11 no 71 73 piso 3 —<br>Edificio Davivienda</li>
        </ul>
        <div class="mt-8 text-[15px] text-gray-800">Proyectiva Agencia de Seguros LTDA NIT:<br>900957271-1</div>
      </div>
      <div>
        <h4 class="text-[16px] font-bold text-[#1A1A1A] uppercase tracking-wide mb-4 md:mb-6">Enlaces de Interés</h4>
        <ul class="space-y-4 md:space-y-5 text-gray-800 text-[15px]">
          {footerContent.interes.map((item) => (
            <li><a href={item.url} class="hover:text-[#E85D25]">{item.text}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="pt-8 border-t border-gray-300 text-[14px] text-gray-800 text-center md:text-left">
      <p>© {currentYear} Proyectiva. Todos los derechos reservados.</p>
      {additionalContent && <Fragment set:html={` ${additionalContent}`} />}
    </div>
  </div>

  <a href={footerContent.whatsapp} target="_blank" rel="noreferrer" class="fixed bottom-6 right-6 z-50 bg-[#25D366] p-4 rounded-full shadow-lg">
    <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>
</footer>
