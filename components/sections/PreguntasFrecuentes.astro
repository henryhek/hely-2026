---
import FaqItem from "@/components/molecules/FaqItem.astro";
import { resolveSectionData } from "@/data/resolveSectionData";

interface FaqRecord {
  pregunta: string;
  respuesta: string;
}

interface CtaContent {
  titulo: string;
  botonTexto: string;
  url: string;
}

interface SectionContent {
  titulo: string;
  descripcion: string;
  faqs: FaqRecord[];
  cta: CtaContent;
}

const defaultFaqs: FaqRecord[] = [
  {
    pregunta: "¿Por qué asegurar mi carro?",
    respuesta:
      "Asegurar su carro le ayuda a responder mejor ante accidentes, robos, daños a terceros y eventos inesperados. Además, le da acompañamiento y respaldo para que no tenga que asumir solo todos los costos de una eventualidad.",
  },
  {
    pregunta: "¿Cómo cotizar un seguro para mi carro?",
    respuesta:
      "Puede cotizar compartiendo la información básica de su vehículo y del conductor. Con esos datos se valida el plan disponible, sus coberturas y el valor estimado para que pueda elegir la opción que mejor se ajuste a su necesidad.",
  },
  {
    pregunta: "¿Cuánto vale asegurar mi carro?",
    respuesta:
      "El valor depende de variables como el modelo del vehículo, su uso, la ciudad de circulación, el perfil del conductor y las coberturas seleccionadas. Por eso la cotización final siempre se calcula con los datos concretos de su caso.",
  },
  {
    pregunta: "Ya estoy asegurado, ¿Qué hago en caso de accidente?",
    respuesta:
      "Lo ideal es reportar el evento lo antes posible, seguir las instrucciones de asistencia y tener a la mano los datos del siniestro. Así el equipo puede orientarle sobre pasos, documentación y acompañamiento según la situación presentada.",
  },
  {
    pregunta: "¿Qué pasa si alguien que no está asegurado choca mi carro?",
    respuesta:
      "Dependiendo del plan contratado, su seguro puede apoyarle en la atención del daño y luego continuar con el proceso correspondiente. La cobertura exacta depende de las condiciones del producto y del tipo de afectación ocurrida.",
  },
  {
    pregunta: "¿Qué reparaciones cubre mi seguro de carro?",
    respuesta:
      "Las reparaciones cubiertas dependen de la póliza y del evento reportado. Normalmente se revisa el tipo de daño, las coberturas activas y las condiciones del seguro para determinar el alcance de la atención y del arreglo autorizado.",
  },
];

interface Props {
  class?: string;
  id?: string;
  data?: string;
  fondo?: string;
  idBase?: string;
  titulo?: string;
  descripcion?: string;
  faqs?: FaqRecord[];
  cta?: CtaContent;
}

const {
  class: className = "",
  id,
  data: dataPath,
  fondo = "bg-neutral-95",
  idBase = "preguntasFrecuentesSection",
  titulo,
  descripcion,
  faqs,
  cta,
} = Astro.props;

const defaultContent: SectionContent = {
  titulo: "¿Tiene dudas? ¡Nosotros respondemos!",
  descripcion: "Si necesita información adicional, puede preguntarle a nuestra asistente virtual.",
  faqs: defaultFaqs,
  cta: {
    titulo: "Tienes alguna otra en mente",
    botonTexto: "Ir al centro de ayuda",
    url: "#",
  },
};

const sectionContent = resolveSectionData<SectionContent>(dataPath, defaultContent);
const finalTitulo = titulo ?? sectionContent.titulo;
const finalDescripcion = descripcion ?? sectionContent.descripcion;
const finalFaqs = faqs ?? sectionContent.faqs;
const finalCta = cta ?? sectionContent.cta;
---

<section id={id ?? "preguntas-frecuentes"} class:list={["w-full py-16", fondo, className]} data-faq-section={idBase}>
  <div class="container mx-auto max-w-6xl px-4">
    <div class="grid grid-cols-1 lg:grid-cols-[4fr_7fr] gap-12 items-start">
      <div class="pr-0 md:pr-4">
        <h2 class="text-4xl font-extrabold text-[#282828] leading-[1.1] sticky top-24">
          {finalTitulo}
        </h2>
      </div>

      <div class="border border-gray-200 rounded-2xl overflow-hidden shadow-sm flex flex-col bg-white">
        <div id="faq-dynamic-container" class="flex flex-col bg-white pt-2">
          {finalFaqs.map((faq, index) => (
            <FaqItem
              itemId={`${idBase}-${index + 1}`}
              pregunta={faq.pregunta}
              respuesta={faq.respuesta}
              showDivider={index < finalFaqs.length - 1}
            />
          ))}
        </div>

        {finalCta && (
          <div class="bg-[#F4F5F7] p-8 flex flex-col sm:flex-row items-center justify-between gap-6 mt-2">
            <span class="font-bold text-[#1A1A1A] text-[16px]">
              {finalCta.titulo}
            </span>
            <a href={finalCta.url}
              class="px-8 py-2.5 bg-transparent border-[2px] border-[#D84924] rounded-full font-bold text-[#D84924] hover:bg-[#D84924] hover:text-white transition-colors shadow-sm text-[15px]">
              {finalCta.botonTexto}
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const initFaqSections = () => {
    document.querySelectorAll("[data-faq-section]").forEach((section) => {
      if (!(section instanceof HTMLElement) || section.dataset.bound === "true") {
        return;
      }

      section.dataset.bound = "true";

      const triggers = Array.from(section.querySelectorAll("[data-faq-trigger='true']"));

      const closeItem = (trigger) => {
        if (!(trigger instanceof HTMLButtonElement)) {
          return;
        }

        const panelId = trigger.getAttribute("aria-controls");
        const panel = panelId ? document.getElementById(panelId) : null;
        const icon = trigger.querySelector("[data-faq-icon='true']");

        trigger.setAttribute("aria-expanded", "false");
        trigger.dataset.open = "false";

        if (icon instanceof HTMLElement) {
          icon.dataset.open = "false";
        }

        if (panel instanceof HTMLElement) {
          panel.hidden = true;
        }
      };

      const openItem = (trigger) => {
        if (!(trigger instanceof HTMLButtonElement)) {
          return;
        }

        const panelId = trigger.getAttribute("aria-controls");
        const panel = panelId ? document.getElementById(panelId) : null;
        const icon = trigger.querySelector("[data-faq-icon='true']");

        trigger.setAttribute("aria-expanded", "true");
        trigger.dataset.open = "true";

        if (icon instanceof HTMLElement) {
          icon.dataset.open = "true";
        }

        if (panel instanceof HTMLElement) {
          panel.hidden = false;
        }
      };

      triggers.forEach((trigger) => {
        if (!(trigger instanceof HTMLButtonElement)) {
          return;
        }

        trigger.addEventListener("click", () => {
          const isExpanded = trigger.getAttribute("aria-expanded") === "true";

          triggers.forEach((currentTrigger) => {
            closeItem(currentTrigger);
          });

          if (!isExpanded) {
            openItem(trigger);
          }
        });
      });
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFaqSections, { once: true });
  } else {
    initFaqSections();
  }
</script>
