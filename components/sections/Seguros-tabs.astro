---
import Card from "@/components/molecules/Card.astro";
import CarouselControls from "@/components/molecules/CarouselControls.astro";
import { resolveSectionData } from "@/data/resolveSectionData";

interface CardRecord {
  imageSrc: string;
  imageAlt: string;
  titulo: string;
  copy: string;
  urlProteger?: string;
  urlConocerMas?: string;
}

interface SectionContent {
  titulo: string;
  cards: CardRecord[];
}

interface Props {
  class?: string;
  id?: string;
  data?: string;
  fondo?: string;
  idBase?: string;
  titulo?: string;
  cards?: CardRecord[];
}

const defaultCards: CardRecord[] = [
  {
    imageSrc:  "data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' width='1376' height='768'&gt;&lt;rect width='100%' height='100%' fill='%23d1d5db'/&gt;&lt;rect x='630' y='336' width='117' height='96' rx='10' fill='none' stroke='%239ca3af' stroke-width='7'/&gt;&lt;circle cx='660' cy='367' r='10' fill='%239ca3af'/&gt;&lt;path d='M636 425 L678 384 L705 408 L722 394 L740 425 Z' fill='%239ca3af'/&gt;&lt;/svg&gt;",
    imageAlt: "Propiedad en arriendo protegida",
    titulo: "Mi arriendo",
    copy: "Cuidamos tu arriendo, tus servicios y tu propiedad frente a todo daño.",
    urlProteger: "/productos/mi-arriendo/proteger",
    urlConocerMas: "s"
  },
  {      
    imageSrc: "data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' width='1376' height='768'&gt;&lt;rect width='100%' height='100%' fill='%23d1d5db'/&gt;&lt;rect x='630' y='336' width='117' height='96' rx='10' fill='none' stroke='%239ca3af' stroke-width='7'/&gt;&lt;circle cx='660' cy='367' r='10' fill='%239ca3af'/&gt;&lt;path d='M636 425 L678 384 L705 408 L722 394 L740 425 Z' fill='%239ca3af'/&gt;&lt;/svg&gt;", 
    imageAlt: "Automóvil protegido",
    titulo: "Mi carro",
    copy: "Cuidamos tu camino, tu vehículo y a quienes van contigo en cada viaje.",
    urlProteger: "/productos/mi-carro/proteger",
    urlConocerMas: "/productos/mi-"
  },
  {
    imageSrc:  "data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' width='1376' height='768'&gt;&lt;rect width='100%' height='100%' fill='%23d1d5db'/&gt;&lt;rect x='630' y='336' width='117' height='96' rx='10' fill='none' stroke='%239ca3af' stroke-width='7'/&gt;&lt;circle cx='660' cy='367' r='10' fill='%239ca3af'/&gt;&lt;path d='M636 425 L678 384 L705 408 L722 394 L740 425 Z' fill='%239ca3af'/&gt;&lt;/svg&gt;",
    imageAlt: "Casa protegida",
    titulo: "Mi casa",
    copy: "Cuidamos tu casa, tu bienestar y los recuerdos que construyes en ella.",
    urlProteger: "/productos/mi-casa/proteger",
    urlConocerMas: "/productos/mi-casa"
  },
  {
    imageSrc: "https://image.experienciasbolivar.segurosbolivar.com/lib/fe3511747364047b751475/m/1/f8cc4ab0-ebf7-455e-902b-bd952e265aea.jpg",
    imageAlt: "Familia cuidando su salud",
    titulo: "Mi salud",
    copy: "Cuidamos tu salud, tu bienestar y a quienes más amas, en todo momento.",
    urlProteger: "/productos/mi-salud/proteger",
    urlConocerMas: "/productos/mi-salud"
  },
  {
    imageSrc: "data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' width='1376' height='768'&gt;&lt;rect width='100%' height='100%' fill='%23d1d5db'/&gt;&lt;rect x='630' y='336' width='117' height='96' rx='10' fill='none' stroke='%239ca3af' stroke-width='7'/&gt;&lt;circle cx='660' cy='367' r='10' fill='%239ca3af'/&gt;&lt;path d='M636 425 L678 384 L705 408 L722 394 L740 425 Z' fill='%239ca3af'/&gt;&lt;/svg&gt;", 
    imageAlt: "Negocio protegido",
    titulo: "Mi negocio",
    copy: "Cuidamos tu negocio, tus activos y el gran esfuerzo de tu empresa hoy.",
    urlProteger: "/productos/mi-negocio/proteger",
    urlConocerMas: "/productos/mi-negocio"
  },
  {
    imageSrc: "data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' width='1376' height='768'&gt;&lt;rect width='100%' height='100%' fill='%23d1d5db'/&gt;&lt;rect x='630' y='336' width='117' height='96' rx='10' fill='none' stroke='%239ca3af' stroke-width='7'/&gt;&lt;circle cx='660' cy='367' r='10' fill='%239ca3af'/&gt;&lt;path d='M636 425 L678 384 L705 408 L722 394 L740 425 Z' fill='%239ca3af'/&gt;&lt;/svg&gt;",  
    imageAlt: "Familia y futuro protegidos",
    titulo: "Mi vida",
    copy: "Protege a quienes más quieres y haz crecer tu ahorro para el futuro.",
    urlProteger: "/productos/mi-vida/proteger",
    urlConocerMas: "/productos/mi-vida"
  },
];

const {
  class: className = "",
  id,
  data: dataPath,
  fondo = "bg-white",
  idBase = "SegurosSection",
  titulo,
  cards,
} = Astro.props;

const defaultContent: SectionContent = {
  titulo: "¿Qué más quiere asegurar hoy?",
  cards: defaultCards,
};

const sectionContent = resolveSectionData<SectionContent>(dataPath, defaultContent);
const finalTitulo = titulo ?? sectionContent.titulo;
const finalCards = cards ?? sectionContent.cards;
---

<section id={id} class:list={["w-full py-10 md:py-16 xl:py-20", fondo, className]}>
  <div class="shell lg:px-10! xl:px-[72px]! mb-6">
    <div class="flex flex-col gap-6">
      <div class="flex flex-col">
        <h2 class="m-0 max-w-[18ch] text-2xl leading-8 font-bold text-neutral-10 md:max-w-none md:text-[2rem] md:leading-10">
          {finalTitulo}
        </h2>

        <div class="mt-6">
          <nav class="flex gap-8 border-b border-neutral-90 pb-4" role="tablist">
            <button class="text-accion-primaria pb-2 border-b-2 border-accion-primaria" data-tab="all">Todos los seguros</button>
            <button class="text-neutral-40 hover:text-accion-primaria pb-2" data-tab="vida">Mi vida y bienestar</button>
            <button class="text-neutral-40 hover:text-accion-primaria pb-2" data-tab="patrimonio">Mi patrimonio</button>
            <button class="text-neutral-40 hover:text-accion-primaria pb-2" data-tab="negocio">Mi negocio</button>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <div class="shell lg:px-10! xl:px-[72px]!">
    <div class="seguros-grid grid grid-cols-1 gap-6 md:grid-cols-3">
      {finalCards.map((card) => (
        <div>
          <Card
            tipo="imagen"
            estilo="outlined"
            imageSrc={card.imageSrc}
            imageAlt={card.imageAlt}
            titulo={card.titulo}
            copy={card.copy}
            botonPrincipal={{ texto: `Proteger ${card.titulo.toLowerCase()}`, tipo: "primario", url: card.urlProteger }}
            botonSecundario={{ texto: "Conocer más", url: card.urlConocerMas }}
          />
        </div>
      ))}
    </div>
  </div>

  <script is:inline>
    (() => {
      const scriptEl = document.currentScript;
      if (!scriptEl) return;
      const sectionEl = scriptEl.parentElement;
      if (!sectionEl) return;
      const root = sectionEl.querySelector('.seguros-grid');
      if (!root) return;

      const tabs = Array.from(sectionEl.querySelectorAll('[data-tab]'));
      tabs.forEach(tab => tab.addEventListener('click', (e) => {
        const t = e.currentTarget.dataset.tab;
        // For now, simple behavior: show all for 'all', otherwise filter by keyword in title
        const items = Array.from(root.children); // Correctly select the direct grid item divs
        items.forEach(item => {
          const titleEl = item.querySelector('p'); // Assuming 'p' is still inside the article
          const title = titleEl ? (titleEl.textContent || '').toLowerCase() : '';
          if (t === 'all') {
            item.style.display = '';
          } else if (t === 'vida' && (title.includes('vida') || title.includes('salud'))) {
            item.style.display = '';
          } else if (t === 'patrimonio' && (title.includes('casa') || title.includes('arriendo') || title.includes('carro'))) {
            item.style.display = '';
          } else if (t === 'negocio' && title.includes('negocio')) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
        tabs.forEach(tb => tb.classList.remove('text-accion-primaria','border-b-2'));
        e.currentTarget.classList.add('text-accion-primaria','border-b-2');
      }));
    })();
  </script>
</section>
