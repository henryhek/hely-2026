---
import Nav from "@/components/atoms/Nav.astro";
import Breadcrumb from "@/components/atoms/Breadcrumb.astro";
import Footer from "@/components/atoms/Footer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import MenuAncla from "@/components/sections/MenuAncla.astro";
import Asistencias from "@/components/sections/Asistencias.astro";
import Banner from "@/components/sections/Banner.astro";
import BannerHero from "@/components/sections/BannerHero.astro";
import Beneficios from "@/components/sections/Beneficios.astro";
import VentaCruzada from "@/components/sections/VentaCruzada.astro";
import PreguntasFrecuentes from "@/components/sections/PreguntasFrecuentes.astro";

---

<BaseLayout title="Seguro de salud">
    <Nav ctaScrollTo="#cotizar" />

    <main class="flex flex-col">
        <Breadcrumb crumbs={['home', 'productos', 'seguro-salud']} bgColor="bg-white" />
        <BannerHero id="bannerHero" data="salud/bannerHero.json" fondo="bg-primario-60" showButton={true} />
        <MenuAncla data="salud/menuAncla.json" fondo="bg-transparent" />
        <Beneficios id="beneficios" data="salud/beneficios.json" fondo="bg-white" />
        <Banner data="salud/banner.json" fondo="bg-primario-50" ctaScrollTo="#cotizar" />
        <Asistencias id="asistencias" data="salud/asistencias.json" fondo="bg-neutra-95" />
        <PreguntasFrecuentes id="preguntas" data="salud/preguntasFrecuentes.json" fondo="bg-white" />
        <VentaCruzada id="otros-productos" data="salud/ventaCruzada.json" fondo="bg-neutral-95" />
    </main>

    <Footer class="py-8"/>
</BaseLayout>
